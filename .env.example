# Public app settings used by Nuxt and the Supabase Auth client
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase access for private CRM API routes
NUXT_SUPABASE_SECRET_KEY=

# Rex -> CRM webhook signing
NUXT_REX_WEBHOOK_SECRET=
# Optional future CRM -> Rex callback signing
NUXT_CRM_WEBHOOK_SECRET=
NUXT_REX_CALLBACK_URL=

# CRM -> reporter ticket replies
NUXT_RESEND_API_KEY=
NUXT_SUPPORT_FROM_EMAIL=ticket@rexapp.co.uk
NUXT_SUPPORT_FROM_NAME=Rex Support
NUXT_SUPPORT_REPLY_TO_EMAIL=

# GitHub release sync
# You can set owner + repo separately, or put owner/repo / a GitHub URL in NUXT_GITHUB_REPO.
# Private repositories need a GitHub token with read access to repository contents.
NUXT_GITHUB_OWNER=
NUXT_GITHUB_REPO=
NUXT_GITHUB_TOKEN=
